{
  "info": {
    "name": "ServiceBook API",
    "description": "Local Service Booking System API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"9876543210\"\n}" }
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": ["var r = pm.response.json();", "if(r.token) pm.collectionVariables.set('token', r.token);"] } }],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@servicebook.com\",\n  \"password\": \"password\"\n}" }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Services",
      "item": [
        {
          "name": "Get All Services",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/services",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Create Service (Admin)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/services",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Pest Control\",\n  \"description\": \"Eco-friendly pest removal.\",\n  \"price\": 899,\n  \"estimated_duration\": \"2-3 hours\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Get My Bookings",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/bookings",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get All Bookings (Admin)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/bookings/all",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/bookings",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"service_id\": 1,\n  \"booking_date\": \"2026-06-15\",\n  \"address\": \"123 Main Street, Madurai\",\n  \"notes\": \"Please come in the morning\"\n}" }
          }
        },
        {
          "name": "Update Booking Status",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/bookings/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"confirmed\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Providers",
      "item": [
        {
          "name": "Get All Providers (Admin)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/providers",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Create Provider (Admin)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/providers",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"New Provider\",\n  \"phone\": \"9123456780\",\n  \"skill_type\": \"Carpentry\",\n  \"availability_status\": \"available\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "User Dashboard",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/dashboard/user",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Admin Dashboard",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/dashboard/admin",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    }
  ]
}
